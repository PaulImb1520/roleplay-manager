{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "Astro docs": {
        "type": "remote",
        "url": "https://mcp.docs.astro.build/mcp",
        "disabled": false
      },
      "shadcn": {
        "type": "local",
        "command": [
          "pnpm",
          "dlx",
